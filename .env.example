# Copy this file to .env (same folder) and fill it in. .env is gitignored.
# Everything is optional: with no key at all, FloodLine runs on its keyword fallback.

# Google AI Studio key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model that listens to the voice note and returns structured JSON.
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when the main model is unavailable or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest

# Public HTTPS address phones use. run.py fills this in automatically when the tunnel starts.
PUBLIC_URL=

# --- Advanced (defaults shown) ---
# Where the SQLite database, uploaded voice notes/photos and the geocode cache live.
# FLOODLINE_DATA_DIR=data
# Load the 25 demo reports when the database is empty (1) or start empty (0).
# FLOODLINE_SEED=1
# Give up on the AI after this many seconds (the report is kept either way).
# FLOODLINE_AI_TIMEOUT=15
# How long the phone waits for the AI before getting "we're processing your report".
# FLOODLINE_POST_WAIT=9
# Geocoding (OpenStreetMap Nominatim). Identify your deployment if you change it; no personal email.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=FloodLine/0.1 (Hack Dearborn 2026 flood-reporting demo)
